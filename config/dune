(executable
 (name discover)
 (libraries xgboost_config dune-configurator))

; Vendored XGBoost build, run only on the vendored path (see
; provider/dune). Emits the include and runtime-dependency flags for the
; ctypes stanza in ../src/bindings/vendored, the CMake-built static
; archives, and their shared companions for plain bytecode. Depends on the
; vendored sources so it is rebuilt when they change and needs no network.
(rule
 (enabled_if %{read:provider/vendored})
 (targets
  c_flags.sexp
  c_library_flags.sexp
  libxgboost_vendored.a
  libdmlc_vendored.a
  dllxgboost_vendored.so
  dlldmlc_vendored.so)
 (deps
  discover.exe
  (source_tree %{project_root}/vendor/xgboost))
 (action
  (run ./discover.exe)))
