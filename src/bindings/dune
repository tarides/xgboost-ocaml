; Internal layer-B bindings for libxgboost via the dune ctypes plugin.
;
; The plugin reads <xgboost/c_api.h> and emits static stubs. The C
; compile/link flags come from config/discover.ml (hybrid: system
; libxgboost when available, else a vendored CMake build), surfaced here
; through the generated sexps. We copy them from ../../config so the
; ctypes [(:include ...)] resolver, which looks in this directory, finds
; them. Generated entry point is the [C] module; downstream code (the
; layer-C library and tests/benches) uses [Xgboost_bindings.C.Functions].

(rule
 (copy %{project_root}/config/c_flags.sexp c_flags.sexp))

; ctypes must not start linking before the archives are copied here.
(rule
 (deps libxgboost_vendored.a libdmlc_vendored.a)
 (action (copy %{project_root}/config/c_library_flags.sexp c_library_flags.sexp)))

(rule
 (copy %{project_root}/config/libxgboost_vendored.a libxgboost_vendored.a))

(rule
 (copy %{project_root}/config/libdmlc_vendored.a libdmlc_vendored.a))

(rule
 (copy %{project_root}/config/dllxgboost_vendored.so dllxgboost_vendored.so))

(rule
 (copy %{project_root}/config/dlldmlc_vendored.so dlldmlc_vendored.so))

(library
 (name xgboost_bindings)
 (public_name xgboost.bindings)
 (wrapped true)
 (libraries ctypes)
 ; Bundle the vendored static archives (and their .so companions) through
 ; dune rather than raw link flags. Dune links the .a into native and
 ; byte_complete consumers and loads the .so for the plain-bytecode path,
 ; resolving their location for both the in-tree build and a relocated
 ; install — so no manual -L (and no dangling build-relative path) is
 ; recorded in the link metadata.
 ;
 ; foreign_archives records these names in the link / dll-load closure
 ; unconditionally, so on the system path (where discover.ml writes empty
 ; placeholder .a/.so) the placeholders are still installed and referenced.
 ; They are inert — empty archives and symbol-less shared objects that
 ; contribute nothing to a link — but cannot be dropped: dune has no
 ; build-time-conditional foreign_archives (enabled_if cannot see pkg-config
 ; discovery), and removing them would leave the recorded -lxgboost_vendored
 ; references dangling. check-installed-linking.sh asserts this inertness.
 (foreign_archives xgboost_vendored dmlc_vendored)
 (flags (:standard -w -9-27-32-33-37))
 (ctypes
  (external_library_name xgboost)
  ; Use the [vendored] resolver rather than [pkg_config] so we can inject
  ; the warning suppressions ctypes' generated stubs require: XGBoost
  ; declares its borrowed-output pointers as `const T**`, but ctypes can
  ; only emit non-const `T**` — the cast is benign and we silence the
  ; corresponding -Wincompatible-pointer-types warning at the C compiler.
  (build_flags_resolver
   (vendored
    (c_flags (:include c_flags.sexp))
    (c_library_flags (:include c_library_flags.sexp))))
  (headers (preamble "#include <xgboost/c_api.h>"))
  (type_description (instance Types) (functor Type_description))
  (function_description
   (concurrency sequential)
   (instance Functions)
   (functor Function_description))
  (generated_types Types_generated)
  (generated_entry_point C)))
